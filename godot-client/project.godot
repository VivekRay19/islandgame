; Cultural Islands — Godot 4 client
; Modern Godot client. Backend remains the existing Rust server.
config_version=5

[application]
config/name="Cultural Islands"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image=""
boot_splash/bg_color=Color(0.027, 0.055, 0.075, 1)

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.055, 0.075, 1)

[input]
ui_accept={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194309)]}
ui_cancel={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194307)]}
