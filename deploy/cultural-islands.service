[Unit]
Description=Cultural Islands — Island Development & Survival Game Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/islandgame

# Load env vars
EnvironmentFile=/opt/islandgame/.env

# Run the compiled binary
ExecStart=/opt/islandgame/target/release/cultural-islands-server

Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
